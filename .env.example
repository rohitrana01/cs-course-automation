# Copy this to .env and fill in your values

# Anthropic Claude API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# YouTube OAuth credentials (from Google Cloud Console)
YOUTUBE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxx
YOUTUBE_REFRESH_TOKEN=1//xxxxxxxx

# Optional settings
CHANNEL_NAME=LearnCS Daily
TTS_VOICE=en-US-AriaNeural
VIDEO_PRIVACY=public

# Niche & Anime Style Configuration
NICHE="Computer Science"
CHARACTER_DESCRIPTION="A cute 18-year-old anime girl with blue hair, big brown eyes, wearing a white hoodie and headphones around her neck, modern anime art style"
VISUAL_STYLE="beautiful digital anime illustration, vibrant colors, clean lineart, soft shading, high quality, trending on Pixiv"

# Background Music Configuration
ENABLE_MUSIC=true
BACKGROUND_MUSIC_FOLDER=resources/music
BACKGROUND_MUSIC_VOLUME=0.10
